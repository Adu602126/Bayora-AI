      "url": "/journey",
      "icons": [
        { "src": "/icons/shortcut-journey.png", "sizes": "96x96", "type": "image/png" }
      ]
    }
  ],

  "screenshots": [
    {
      "src": "/screenshots/home.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
