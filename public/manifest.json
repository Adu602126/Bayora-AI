  "shortcuts": [
    {
      "name": "SOS Emergency",
      "short_name": "SOS",
      "description": "Activate emergency SOS immediately",
      "url": "/sos",
      "icons": [
        { "src": "/icons/shortcut-sos.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Plan Safe Route",
      "short_name": "Routes",
      "description": "Find the safest route to your destination",
      "url": "/routes",
      "icons": [
        { "src": "/icons/shortcut-routes.png", "sizes": "96x96", "type": "image/png" }
      ]
    },
    {
      "name": "Live Journey",
      "short_name": "Track",
